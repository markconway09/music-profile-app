generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth / core ----------

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favoriteArtists UserFavoriteArtist[]
  topSongs        UserTopSong[]
  biases          UserBias[]
}

// ---------- Catalog ----------

enum ArtistType {
  SOLO
  GROUP
}

enum ArtistOrigin {
  KPOP
  JPOP
  OTHER
}

model Artist {
  id            String       @id @default(cuid())
  name          String
  type          ArtistType
  origin        ArtistOrigin
  imageUrl      String?
  spotifyId     String?      @unique
  musicbrainzId String?      @unique
  createdAt     DateTime     @default(now())

  songs   Song[]
  members GroupMember[]

  favoritedBy UserFavoriteArtist[]
  biases      UserBias[]

  @@index([name])
}

model Song {
  id          String  @id @default(cuid())
  title       String
  artistId    String
  imageUrl    String?
  previewUrl  String?
  spotifyId   String? @unique
  artist      Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  topByUsers UserTopSong[]

  @@index([artistId])
}

// Source of a group member's data, so we know whether it's safe to
// overwrite on a future MusicBrainz re-sync vs. a user's manual edit.
enum MemberSource {
  MUSICBRAINZ
  MANUAL
}

model GroupMember {
  id            String       @id @default(cuid())
  name          String
  artistId      String
  imageUrl      String?
  musicbrainzId String?      @unique
  source        MemberSource @default(MANUAL)
  // Informational only — when enrichment last ran for this member. Doesn't
  // gate future runs; the button always re-checks so a member that failed
  // due to e.g. transient API flakiness (or a source getting new data
  // since) isn't stuck that way forever.
  enrichAttemptedAt DateTime?
  // Set when the user edits this member by hand, which *does* gate future
  // enrichment — their manual fix is the final say, never silently
  // overwritten by a later automated re-check.
  manuallyEdited Boolean      @default(false)
  // True when `name` came from the algorithmic character-by-character
  // romanizer — the lowest-confidence source, used only when neither a
  // MusicBrainz alias nor a Wikidata label was available. It can produce
  // technically-Latin but wrong results (e.g. "Gimchaewon" instead of the
  // real stage name "Chaewon", since it can't know where a surname ends).
  // Without this flag, needsRomanization() sees an already-Latin string
  // and treats the name as permanently resolved, so a later run where a
  // better source *does* have data would never get a chance to fix it.
  nameIsAlgorithmic Boolean   @default(false)
  artist         Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)

  biasedBy UserBias[]

  @@index([artistId])
}

// ---------- User-curated lists ----------

model UserFavoriteArtist {
  userId   String
  artistId String
  rank     Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
}

model UserTopSong {
  userId String
  songId String
  rank   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}

// A member the user has ticked as a "bias" for that group. `isUlt` marks
// their single ultimate bias per group; `ultRank` orders ult biases across
// all of the user's groups (null for non-ult biases). Checking "ult" implies
// "bias" — the row's mere existence is the bias tick, isUlt is an add-on.
model UserBias {
  userId   String
  memberId String
  groupId  String
  isUlt    Boolean @default(false)
  ultRank  Int?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group  Artist      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, memberId])
}
